# Copy to .env for local development. Matches docker-compose.yml (local-only credentials).
DATABASE_URL="postgresql://tob:tob@localhost:5432/tob_dev?schema=public"

# Book cover fetcher (npm run covers:fetch): a contact address or URL sent in the User-Agent, and an optional Google Books key.
COVERS_CONTACT=
GOOGLE_BOOKS_API_KEY=

# Book content tool (npm run content -- check --verify-sources): a contact address or URL sent in the User-Agent.
CONTENT_CONTACT=
COVERS_CONTACT=
GOOGLE_BOOKS_API_KEY=